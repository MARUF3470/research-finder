generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"

}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String
  image         String?
  address       String?
  phone         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  searches      Search[]
  subscription  Subscription?
}

model Plan {
  id            String   @id @default(cuid())
  name          String   // Free / Pro
  price         Int      // cents (0 = free)
  searchLimit   Int?     // null = unlimited

  createdAt     DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  planId    String

  status    String   // active, canceled
  startDate DateTime
  endDate   DateTime?

  user      User @relation(fields: [userId], references: [id])
  plan      Plan @relation(fields: [planId], references: [id])
}

model Search {
  id        String   @id @default(cuid())
  query     String
  userId    String

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  results   Result[]
}

model Result {
  id        String @id @default(cuid())
  searchId  String

  title     String
  authors   String
  year      Int
  citations Int?

  summary       String?
  methodology   String?
  keyFindings   String?
  limitations   String?
  futureWork    String?
  references    String?

  publishedIn String?
  link        String @unique

  pdfUrl String?

  analysisStatus String @default("PENDING")

  createdAt DateTime @default(now())

  search Search @relation(fields: [searchId], references: [id])
}
